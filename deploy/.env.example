# 要运行的镜像版本（对应 GitHub 上的 tag vX.Y.Z，这里不带 v）
APP_VERSION=0.1.0
# 数据库密码，只用字母和数字，生成：python3 -c "import secrets;print(secrets.token_hex(24))"
# 只在第一次启动、初始化数据库时生效；之后要改密码需同时在数据库里修改
POSTGRES_PASSWORD=
# 应用只监听本机这个端口，由 Nginx 等反向代理转发
APP_PORT=8000

# 模型：可留空，改在页面「模型设置」中填写（保存在浏览器）；
# 但简历池身份提取、邮箱附件识图等后台任务只读这里的配置。
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.example.com/v1
TEXT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
VISION_ENABLED=true

# 邮箱简历自动捕获（选填）：配置后周期拉取未读邮件中的简历附件进入「简历池」
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=hr@example.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_POLL_SECONDS=300

# 其余参数（并发、文件大小上限等）见仓库 README 的「环境变量」表，同样写在这里
