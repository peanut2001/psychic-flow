# 候选人简历和岗位信息会发送到这个兼容接口。
# 可留空，改在页面「模型设置」中填写（保存在浏览器本地，随请求携带）；
# 但简历池身份提取、邮箱附件识图等后台任务只读这里的配置。
OPENAI_API_KEY=
# 兼容 OpenAI 官方时无需设置；使用 DeepSeek 或企业网关时取消注释。
# OPENAI_BASE_URL=https://api.example.com/v1
TEXT_MODEL=gpt-4o-mini
VISION_MODEL=gpt-4o-mini
VISION_ENABLED=true

DATABASE_URL=postgresql+psycopg://hireflow:hireflow@db:5432/hireflow
DATA_DIR=data
MAX_CONCURRENCY=5
MAX_FILE_MB=20
MAX_PDF_PAGES=50
MAX_RESUMES_PER_JOB=200
MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_RETRIES=2
# 如果本机 8000 端口被占用，可改为 8010 等其他端口。
APP_PORT=8000

# 邮箱简历自动捕获：配置后后台按 IMAP_POLL_SECONDS 周期拉取未读邮件中的简历附件，
# 附件先进入首页「简历池」，再由人工分配岗位并评估。
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=hr@example.com
# IMAP_PASSWORD=
# IMAP_MAILBOX=INBOX
# IMAP_POLL_SECONDS=300
